{
  "name": "hal-js",
  "version": "0.3.0",
  "description": "HAPPI/1.3 JavaScript/TypeScript client library \u2014 AI as a syscall. Zero-dep core, runs under Node/Deno/Bun.",
  "license": "MIT",
  "author": "CodeTonight (Pty) Ltd t/a ENTER Konsult",
  "homepage": "https://github.com/CodeTonight-SA/hal-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeTonight-SA/hal-js.git"
  },
  "keywords": [
    "happi",
    "hal",
    "ai",
    "syscall",
    "ndjson",
    "stdio",
    "anthropic",
    "claude",
    "deno",
    "bun"
  ],
  "type": "module",
  "exports": {
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js",
      "require": "./dist/envelope.cjs"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./cite": {
      "types": "./dist/cite.d.ts",
      "import": "./dist/cite.js",
      "require": "./dist/cite.cjs"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js",
      "require": "./dist/providers/anthropic.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:bun": "bun test --preload ./tests/_bun-preload.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0"
  },
  "bin": {
    "hal-js": "./dist/cli.js"
  },
  "tsup": {
    "entry": [
      "src/envelope.ts",
      "src/events.ts",
      "src/client.ts",
      "src/cite.ts",
      "src/cli.ts",
      "src/runtime.ts",
      "src/providers/anthropic.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "clean": true
  }
}
